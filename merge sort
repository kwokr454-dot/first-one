def merge_sort(arr):

  if len(arr) <= 1:
        return arr

  len_original=len(arr)
  half_original=len(arr)//2
  sorted1=merge_sort(arr[0:half_original])
  sorted2=merge_sort(arr[half_original:len(arr)])

  return merged(sorted1,sorted2)

def merged(list1,list2):

  sorted_list=[]
  while len(list1)>0 and len(list2)>0:
    if list1[0] < list2[0]:
      sorted_list.append(list1.pop(0))
  ## remove the value from list1 but pop returns it so i can append it to sorted list

    else:
      sorted_list.append(list2.pop(0))


  sorted_list.extend(list1)
  sorted_list.extend(list2)

  return sorted_list





list=input("Give me a list and seperate with ,")
