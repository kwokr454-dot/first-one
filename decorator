## decorator basically allows u to use another function anywher inside the original function
## this is used as the original way to do it is limited, if u want to add multiple function you need to write it like 50 timnes

#e.g

def my_code():
    print("Sorting logic running...")

def wrapper():
    print("--- Before ---")
    my_code() # You call your code here manually
    print("--- After ---")

# You call the wrapper
wrapper()


# but you can do it this way


# 1. This is the "Adapter" (The Decorator)
def my_decorator(func):
    def wrapper():
        print("--- BEFORE: Clock started ---")
        func()  # This runs your original code!
        print("--- AFTER: Clock stopped ---")
    return wrapper

# 2. This is your "Original Function"
@my_decorator
def my_code():
    print("Sorting logic running...")

# 3. Execution
my_code()

