def saving_high_score():
    try:
        ### try is for doing it and if it doesnt work, it goes to except, like if else
        my_file = open("highscore.txt", "r")
        ### highscore.txt is the location assigned and r means read(w means write) which is the job assigned to it
        ### open is to basically physically open a file
        high_score = int(my_file.read())
        
        my_file.close()
        ### closing the file as the data has already been extracted
    except:
        ### this means the try didnt work, which made the high_score = 0
        high_score=0


    if high_score<correct:
        print("you got a new high score")
        my_file = open("highscore.txt", "w")
        high_score = my_file.write(str(correct))
        my_file.close()
    elif high_score == correct:
        print("you got the same as your high score, try again to beat")
    else:
        print("i cant lie, you did really good but it was still lower than your high score")
        
        

