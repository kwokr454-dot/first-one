def binary_search(l,value):
    global list_input
    print(l)
    index=len(l)//2
    w=l[index]
    if len(l) != 1:
        
        try:
            if int(w)>value:
                return binary_search(l[0:index],value)
                binary_search(l,value)
            elif int(w)<value:
                return binary_search(l[index+1:],value)
                binary_search(l,value)
            else:
                print("found")
                return True
                
        except:
            return False
    else:
        return False

list_input=input("Enter the list")
list_input=list(list_input)
value=int(input("Enter the number"))
print(binary_search(list_input,value))

