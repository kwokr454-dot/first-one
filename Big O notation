# Big O notation is basically a "complexity score" for your code. It tells you how much longer your program will take to finish if your input list gets 10, 100, or 1,000,000 times bigger.


### using the two sum - leetcode #1 as example

def slow_two_sum(nums, target):
    for i in nums: # Loop 1
        needed = target - i
        if str(needed) in nums: # Searching is Loop 2 (hidden)
            return True
    return False



# O(n) - Linear Time
def two_sum(nums, target):
    seen = {}
    
    for i, num in enumerate(nums):
        needed = target - num
        
        # 1. Check: Is the 'needed' number in our history log (seen)?
        # If yes, we found our pair!
        if needed in seen:
            return [seen[needed], i]
        
        # 2. Store: If we didn't find the pair, add the current number 
        # and its index to the dictionary so it can be 'needed' by a future number.
        seen[num] = i
        
    return None


### O(1) = constant
### O(n) = linear
### O(n^2) = quadratic
