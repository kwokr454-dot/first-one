# Big O notation is basically a "complexity score" for your code. It tells you how much longer your program will take to finish if your input list gets 10, 100, or 1,000,000 times bigger.


### using the two sum - leetcode #1 as example

def slow_two_sum(nums, target):
    for i in nums: # Loop 1
        needed = target - i
        if str(needed) in nums: # Searching is Loop 2 (hidden)
            return True
    return False



# O(n) - Linear Time
def fast_two_sum(nums, target):
    seen = {}
    for i, num in enumerate(nums): # Loop 1 (only once!)
        needed = target - num
        if needed in seen: # Dictionary lookup is instant (O(1))
            return True
        seen[num] = i
    return False


### O(1) = constant
### O(n) = linear
### O(n^2) = quadratic
